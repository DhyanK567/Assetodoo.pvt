# Odoo Asset Management - Frontend Environment Configuration
# Copy this file to .env.local and populate the values before starting the dev server

# ==========================================
# Core API Connectivity
# ==========================================
# URL pointing to the backend API server. Must include trailing slash.
# Development: http://localhost:8080/api/v1/
# Production: https://api.yourdomain.com/v1/
VITE_API_URL=http://localhost:8080/api/v1/

# Defines if the frontend should bypass the real API and use the local mock DB.
# Set to 'false' to connect to the real backend.
VITE_USE_MOCK_API=true

# ==========================================
# Authentication & Security
# ==========================================
# Domain for authentication cookies / JWT issuance if using cross-domain SSO
VITE_AUTH_DOMAIN=

# Optional: Session timeout threshold in minutes
VITE_SESSION_TIMEOUT_MINUTES=60

# ==========================================
# Feature Flags
# ==========================================
# Enable robust reporting/analytics dashboard
VITE_FEATURE_REPORTS_ENABLED=true

# Enable Audit stocktake system
VITE_FEATURE_AUDITS_ENABLED=true
